# Copie para .env e TROQUE todos os valores:  cp .env.example .env
# O arquivo .env esta no .gitignore e nunca deve ser versionado.

# PostgreSQL (usuario usado pelos 4 servicos, cada um em seu proprio banco)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Segredo HMAC dos tokens JWT: no minimo 32 caracteres.
# Gere um valor aleatorio com:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-with-at-least-32-chars

# Usuarios do login no API Gateway (POST /auth/login)
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-me-admin
GATEWAY_USER_USERNAME=user
GATEWAY_USER_PASSWORD=change-me-user
